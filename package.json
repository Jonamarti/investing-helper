{
  "name": "investing-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Comparador de estrategias de inversión: amortizar deuda vs bonos vs renta variable vs efectivo",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @investing-helper/web",
    "dev": "npm run dev -w @investing-helper/web",
    "preview": "npm run preview -w @investing-helper/web",
    "lint": "npm run lint:eslint && npm run lint:format && npm run lint:deps",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check .",
    "lint:deps": "depcruise .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @investing-helper/core",
    "test:watch": "npm run test:watch -w @investing-helper/core",
    "test:coverage": "npm run test:coverage -w @investing-helper/core",
    "test:e2e": "npm run test:e2e -w @investing-helper/web",
    "test:e2e:ui": "npm run test:e2e:ui -w @investing-helper/web",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "globals": "^17.12.0",
    "@vitest/coverage-v8": "^5.0.2",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
