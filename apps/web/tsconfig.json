{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "paths": {
      "@investing-helper/core": ["../../packages/core/src/index.ts"],
      "@investing-helper/core/application": ["../../packages/core/src/application/index.ts"],
      "@investing-helper/core/application/ports": [
        "../../packages/core/src/application/ports/index.ts"
      ],
      "@investing-helper/core/domain/model": ["../../packages/core/src/domain/model/index.ts"],
      "@investing-helper/core/domain/shared": ["../../packages/core/src/domain/shared/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "test", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
