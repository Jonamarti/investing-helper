{
  "name": "@investing-helper/core",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de simulación: TypeScript puro, cero dependencias, sin DOM",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./application": "./src/application/index.ts",
    "./application/ports": "./src/application/ports/index.ts",
    "./domain/model": "./src/domain/model/index.ts",
    "./domain/shared": "./src/domain/shared/index.ts"
  },
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
